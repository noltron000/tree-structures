{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,                                    // Generates .d.ts files for the build.
		"noEmit": false,                                        // Needed to emit build files.
		"rootDir": "./source",                                  // Directory of source files.
		"outDir": "./build",                                    // Directory of emitted files.
		"rewriteRelativeImportExtensions": true,                // Rewrites ts/tsx/cts/mts/ into js equivalents.
	},
}
