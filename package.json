{
	"name": "@noltron000/tree-structures",
	"private": false,
	"license": "MIT",
	"version": "0.0.2",
	"description": "A suite of tree-structured data classes.",
	"keywords": [
		"tree-structures",
		"tree",
		"trees",
		"data",
		"data structure",
		"data structures"
	],
	"homepage": "https://github.com/noltron000/tree-structures#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noltron000/tree-structures.git"
	},
	"bugs": {
		"email": "noltron000@gmail.com",
		"url": "https://github.com/noltron000/tree-structures/issues"
	},
	"author": {
		"name": "Nolan Kovacik",
		"email": "noltron000@gmail.com",
		"url": "https://nebuloid.dev/"
	},
	"contributors": [
		{
			"name": "Frances Coronel",
			"email": "fvcproductions@gmail.com",
			"url": "https://francescoronel.com/"
		}
	],
	"type": "module",
	"main": "./build/index.mjs",
	"files": ["build"],
	"imports": {
		"#classes/*": {
			"development": "./source/classes/*/index.mts",
			"default": "./build/classes/*/index.mjs"
		},
		"#data/*": {
			"development": "./source/data/*/index.mts",
			"default": "./build/data/*/index.mjs"
		},
		"#tools/*": {
			"development": "./source/tools/*/index.mts",
			"default": "./build/tools/*/index.mjs"
		},
		"#types/*": {
			"development": "./source/types/*.d.mts",
			"default": "./build/types/*.d.mts"
		},
		"#source/*": {
			"development": "./source/*.mts",
			"default": "./build/*.mjs"
		}
	},
	"exports": {
		"types": "./build/index.d.mts",
		"import": "./build/index.mjs"
	},
	"scripts": {
		"start": "node --conditions=development --import=tsx ./source/index.mts",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "yarn build"
	},
	"dependencies": { },
	"devDependencies": {
		"@types/node": "^26.6",
		"node": "^26.12",
		"tsx": "^4.23.15",
		"typescript": "^7.0"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
